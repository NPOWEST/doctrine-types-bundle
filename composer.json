{
    "name": "npowest/doctrine-types-bundle",
    "description": "This bundle adds Doctrine Types.",
    "type": "symfony-bundle",
    "license": [ "MIT" ],
    "authors": [
        {
            "name": "Npowest",
            "homepage": "https://npowest.ru/",
            "role": "Developer Npowest"
        }
    ],
    "autoload": {
        "psr-4": {
            "Npowest\\Bundle\\DoctrineTypes\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/flex": "^2.2",
        "doctrine/dbal": "^3.6",
        "symfony/dependency-injection": "7.1.*",
        "symfony/config": "7.1.*",
        "symfony/http-kernel": "7.1.*",
        "npowest/garden-helper": "^1.0",
        "symfony/phpunit-bridge": "^7.2"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.1.*"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "friendsofphp/php-cs-fixer": true,
            "nunomaduro/phpinsights": true,
            "phpmd/phpmd": true,
            "phpstan/phpstan": true,
            "phpstan/phpstan-symfony": true,
            "squizlabs/php_codesniffer": true,
            "phpstan/phpstan-strict-rules": true
        }
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "friendsofphp/php-cs-fixer": "^3.64",
        "nunomaduro/phpinsights": "^2.11",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan-strict-rules": "^2"
    }
}
